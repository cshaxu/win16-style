#include <windows.h>
2010 DIALOGEX 0, 0, 220, 110
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "General"
FONT 8, "MS Shell Dlg"
BEGIN
 LTEXT "Native property page", -1, 10, 10, 190, 12
 EDITTEXT 3010, 10, 30, 190, 14, ES_AUTOHSCROLL
 CONTROL "Enabled", 3011, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 54, 160, 14
END
2011 DIALOGEX 0, 0, 220, 110
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Options"
FONT 8, "MS Shell Dlg"
BEGIN
 LTEXT "Native controls retain their state and notifications.", -1, 10, 10, 190, 26
 CONTROL "First", 3020, "BUTTON", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 10, 44, 180, 14
 CONTROL "Second", 3021, "BUTTON", BS_AUTORADIOBUTTON, 10, 64, 180, 14
END
