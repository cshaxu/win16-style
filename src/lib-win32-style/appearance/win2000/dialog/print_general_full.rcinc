PRINT_GENERAL_LAYOUT DIALOGEX 0, 0, 292, PRINT_GENERAL_PAGE_HEIGHT
STYLE DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "General"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Select printer", -1, 7, 7, 278, 104
    LISTBOX WIN2K_PRINT_DEVICE, 14, 17, 264, 53, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT "Status:", -1, 14, 76, 34, 9
    LTEXT "", WIN2K_PRINT_DEVICE_STATUS, 50, 76, 154, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT "Location:", -1, 14, 87, 34, 9
    LTEXT "", WIN2K_PRINT_DEVICE_LOCATION, 50, 87, 154, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT "Comment:", -1, 14, 98, 34, 9
    LTEXT "", WIN2K_PRINT_DEVICE_COMMENT, 50, 98, 154, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    AUTOCHECKBOX "Print to file", WIN2K_PRINT_FILE, 212, 76, 66, 10
    PUSHBUTTON "Preferences...", WIN2K_PRINT_PREFERENCES, 212, 91, 66, 14
    GROUPBOX "Page range", -1, 7, 118, 162, PRINT_GENERAL_GROUP_HEIGHT
    AUTORADIOBUTTON "All", WIN2K_PRINT_ALL, 14, 130, 48, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Selection", WIN2K_PRINT_SELECTION, 80, 130, 62, 10
    AUTORADIOBUTTON "Current page", WIN2K_PRINT_CURRENT, 14, 145, 62, 10
    AUTORADIOBUTTON "Pages", WIN2K_PRINT_PAGES, 80, 145, 76, 10
    EDITTEXT WIN2K_PRINT_RANGE, 14, 161, 146, 12, ES_AUTOHSCROLL | WS_GROUP
    GROUPBOX "Copies", -1, 175, 118, 110, PRINT_GENERAL_GROUP_HEIGHT
    LTEXT "Number of copies:", -1, 183, 132, 67, 10
    EDITTEXT WIN2K_PRINT_COPIES, 252, 129, 25, 12, ES_NUMBER | ES_AUTOHSCROLL
    AUTOCHECKBOX "Collate", WIN2K_PRINT_COLLATE, 183, 151, 78, 10
    LTEXT "", WIN2K_PRINT_STATUS, 8, PRINT_GENERAL_STATUS_TOP, 270, 11
END
