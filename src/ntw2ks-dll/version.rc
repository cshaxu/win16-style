#include <windows.h>
#include "lib-win32-style/appearance/win2000/dialog/print_general.h"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,28,0,0
PRODUCTVERSION 0,28,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Windows 2000 classic style component (experimental)"
      VALUE "FileVersion", "M0 T28"
      VALUE "ProductName", "Win16 Style"
      VALUE "ProductVersion", "0.28.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

3 RCDATA "LICENSE"
4 RCDATA "lib-win32/process-hook/minhook/LICENSE.txt"

WIN2K_PRINT_GENERAL DIALOGEX 0, 0, 194, 91
STYLE DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "General"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Printer", -1, 8, 3, 178, 10
    COMBOBOX WIN2K_PRINT_DEVICE, 8, 14, 115, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Preferences...", WIN2K_PRINT_PREFERENCES, 127, 14, 59, 14
    GROUPBOX "Pages", -1, 8, 30, 107, 47
    AUTORADIOBUTTON "All", WIN2K_PRINT_ALL, 15, 40, 48, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Selection", WIN2K_PRINT_SELECTION, 65, 40, 46, 10
    AUTORADIOBUTTON "Current page", WIN2K_PRINT_CURRENT, 15, 51, 48, 10
    AUTORADIOBUTTON "Range", WIN2K_PRINT_PAGES, 65, 51, 46, 10
    EDITTEXT WIN2K_PRINT_RANGE, 15, 62, 92, 12, ES_AUTOHSCROLL | WS_GROUP
    GROUPBOX "Output", -1, 121, 30, 65, 47
    LTEXT "Copies", -1, 127, 41, 24, 10
    EDITTEXT WIN2K_PRINT_COPIES, 157, 38, 23, 12, ES_NUMBER | ES_AUTOHSCROLL
    AUTOCHECKBOX "Collate", WIN2K_PRINT_COLLATE, 127, 51, 53, 10
    AUTOCHECKBOX "Print to file", WIN2K_PRINT_FILE, 127, 64, 53, 10
    LTEXT "", WIN2K_PRINT_STATUS, 8, 79, 178, 11
END

WIN2K_PRINT_GENERAL_FULL DIALOGEX 0, 0, 292, 198
STYLE DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "General"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Select printer", -1, 7, 7, 278, 104
    LISTBOX WIN2K_PRINT_DEVICE, 14, 17, 264, 53, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT "Status:", -1, 14, 76, 34, 9
    LTEXT "", WIN2K_PRINT_DEVICE_STATUS, 50, 76, 154, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT "Location:", -1, 14, 87, 34, 9
    LTEXT "", WIN2K_PRINT_DEVICE_LOCATION, 50, 87, 154, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT "Comment:", -1, 14, 98, 34, 9
    LTEXT "", WIN2K_PRINT_DEVICE_COMMENT, 50, 98, 154, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    AUTOCHECKBOX "Print to file", WIN2K_PRINT_FILE, 212, 76, 66, 10
    PUSHBUTTON "Preferences...", WIN2K_PRINT_PREFERENCES, 212, 91, 66, 14
    GROUPBOX "Page range", -1, 7, 118, 162, 64
    AUTORADIOBUTTON "All", WIN2K_PRINT_ALL, 14, 130, 48, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Selection", WIN2K_PRINT_SELECTION, 80, 130, 62, 10
    AUTORADIOBUTTON "Current page", WIN2K_PRINT_CURRENT, 14, 145, 62, 10
    AUTORADIOBUTTON "Pages", WIN2K_PRINT_PAGES, 80, 145, 76, 10
    EDITTEXT WIN2K_PRINT_RANGE, 14, 161, 146, 12, ES_AUTOHSCROLL | WS_GROUP
    GROUPBOX "Copies", -1, 175, 118, 110, 64
    LTEXT "Number of copies:", -1, 183, 132, 67, 10
    EDITTEXT WIN2K_PRINT_COPIES, 252, 129, 25, 12, ES_NUMBER | ES_AUTOHSCROLL
    AUTOCHECKBOX "Collate", WIN2K_PRINT_COLLATE, 183, 151, 78, 10
    LTEXT "", WIN2K_PRINT_STATUS, 8, 185, 270, 11
END
