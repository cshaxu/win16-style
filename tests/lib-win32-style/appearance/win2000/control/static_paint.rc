#include <windows.h>
200 DIALOGEX 0,0,160,80
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Owned Win2000 dialog"
FONT 8,"MS Shell Dlg"
BEGIN
    GROUPBOX "Options",201,5,5,150,55
    LTEXT "&Label",202,10,20,50,10
    CONTROL "Check",203,"BUTTON",BS_AUTOCHECKBOX | WS_TABSTOP,70,20,70,12
    PUSHBUTTON "Close",IDOK,100,65,50,12
END
